# Copia estos nombres en Vercel: Settings -> Environment Variables.
# Este fichero es solo una plantilla: NO pongas aquí los valores reales.

# ID de cliente OAuth (Google Auth Platform -> Clients). Es público.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Correos con acceso, separados por comas. Cualquier otro será rechazado.
ALLOWED_EMAILS=uno@gmail.com,dos@gmail.com

# ID del documento: en la URL de la hoja, entre /d/ y /edit
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Cuenta de servicio con acceso de lectura a la hoja (del fichero JSON descargado)
GOOGLE_SERVICE_ACCOUNT_EMAIL=baecount-reader@mi-proyecto.iam.gserviceaccount.com

# Clave privada del mismo JSON. SECRETO: pégala solo en Vercel.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
